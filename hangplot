#!/usr/bin/env python
import argparse
import calendar
import math
import os

import numpy
import colored_traceback.always

import hangutils
from hangutils import min_weight_increment

# ----------------------------------------------------------------------------------------
helpstr = """
hangplot                                                        # 2019-2025: hanging, both hands, send-fraction bars
hangplot --years 2026 --plotdir ~/hangplots-2026                # 2026-: lifting off the ground, one line per hand
"""
parser = argparse.ArgumentParser(description=helpstr, formatter_class=argparse.RawDescriptionHelpFormatter)
parser.add_argument('--years', default='2019:2020:2022:2023:2024:2025') #2018, 2019, 2020])
parser.add_argument('--plot-grips', default='half-crimp:full-crimp:MRP:med-pinch:MR:IM')  # :thin-pinch
parser.add_argument('--training-dir', default=os.getenv('HOME') + '/Dropbox/hill/training')
parser.add_argument('--plotdir', default='%s/hangplots' % os.getenv('HOME'))
parser.add_argument('--debug', action='store_true')
parser.add_argument('--add-body-weight', action='store_true', help='add body weight to plotted weights (only makes sense for hanging workouts, i.e. mode: hang)')
args = parser.parse_args()

args.years = args.years.split(':')
args.plot_grips = args.plot_grips.replace('-', ' ').split(':')

# ----------------------------------------------------------------------------------------
hangfos = []
for year in args.years:
    hangfname = '%s/%s/hangboard.txt' % (args.training_dir, year)
    hangfos.append(hangutils.read_hfo(hangfname, year, debug=args.debug))

all_cfgs = [hfo['cfg'] for workouts in hangfos for hfo in workouts]
if len(all_cfgs) == 0:
    raise Exception('no workouts read from %s for years %s' % (args.training_dir, ':'.join(args.years)))
if len(set(c['mark_fails'] for c in all_cfgs)) > 1:
    raise Exception('can\'t plot old- and new-format workouts together (run them separately, into separate --plotdirs)')
new_format = all_cfgs[0]['mark_fails'] == 'light'
if args.add_body_weight and any(hangutils.is_lift(c) for c in all_cfgs):
    raise Exception('--add-body-weight doesn\'t make sense for \'mode: lift\' workouts (the weight is off the ground, not hanging from you)')

# ----------------------------------------------------------------------------------------
import matplotlib as mpl
mpl.use('Agg')
mpl.rcParams['svg.fonttype'] = 'none'
mpl.rcParams['svg.hashsalt'] = 'hangplot'  # so two runs give byte-identical svgs (matplotlib otherwise randomizes element ids)
import matplotlib.pyplot as plt
import seaborn
seaborn.set_style('ticks')
fsize = 20
mpl.rcParams.update({
    # 'legend.fontweight': 900,
    'legend.fontsize': fsize,
    'axes.titlesize': fsize,
    # 'axes.labelsize': fsize,
    'xtick.labelsize': fsize,
    'ytick.labelsize': fsize,
    'axes.labelsize': fsize
})

hand_colors = {'L': '#2a78d6', 'R': '#eb6834', 'both': 'grey'}  # blue/orange: passes the colorblind-separation checks
hand_dodge = 0.13  # how far to nudge each hand off the session's x position

# ----------------------------------------------------------------------------------------
def iter_grip_sessions(gripname):
    """Yield (hfo, xval, starts_block) for every workout that includes <gripname>, leaving a
    gap on the x axis between training blocks (a block starts at session 1)."""
    isession, started = 0, False
    for workouts in hangfos:
        for hfo in workouts:
            if gripname not in hfo['grips']:
                continue
            starts_block = hfo['session'] == 1
            if starts_block:
                if started:  # add gap between blocks (but not before first block)
                    isession += 2
                started = True
            if not started:  # haven't hit the start of a block yet
                continue
            xval = isession
            isession += 1
            yield hfo, xval, starts_block

# ----------------------------------------------------------------------------------------
def start_figure(gripname):
    dpi = 80
    xpixels, ypixels = 2500, 700
    fig, ax = plt.subplots(figsize=(xpixels / dpi, ypixels / dpi))
    fig.tight_layout()
    plt.gcf().subplots_adjust(bottom=0.27, left=0.05, right=0.95, top=0.92)
    return fig, ax

# ----------------------------------------------------------------------------------------
def finish_figure(gripname, xticks, xticklabels, ax):
    plt.xticks(xticks)
    plt.title(gripname, fontweight='bold', fontsize=20)
    ax.grid(axis='y')
    ax.tick_params(labelright=True)
    ax.set_xticklabels(xticklabels, rotation='vertical')
    if not os.path.exists(args.plotdir):
        os.makedirs(args.plotdir)
    plt.savefig('%s/%s.svg' % (args.plotdir, gripname.replace(' ', '-')))
    plt.close()

# ----------------------------------------------------------------------------------------
def xtick_label(hfo):
    return '%d %s \'%d' % (hfo['date'].day, calendar.month_abbr[hfo['date'].month], hfo['date'].year - 2000)

# ----------------------------------------------------------------------------------------
def plot_grip_legacy(gripname):
    """Old format: one grey line per set, with a green/red bar showing the fraction of the
    set I finished before failing."""
    # ----------------------------------------------------------------------------------------
    def plot_set(set_key, vbar=True):
        for n_days_list, lw_list, sf_list in zip(mfos['sessions'], mfos[set_key + '-weights'], mfos[set_key + '-send-fractions']):
            # filter out NaN values for plotting
            valid = [(nd, lw, sf) for nd, lw, sf in zip(n_days_list, lw_list, sf_list) if not numpy.isnan(lw)]
            if not valid:
                continue
            valid_nds, valid_lws, valid_sfs = zip(*valid)
            ax.plot(valid_nds, valid_lws, linewidth=3, alpha=0.7, markersize=15, marker='.', color='grey')
            if vbar:
                for nd, lw, sf in zip(valid_nds, valid_lws, valid_sfs):
                    if sf == 0:  # unknown (should change this)
                        ax.text(nd - 0.25, lw + 0.25 * min_weight_increment, '?')
                    else:
                        vw = 8
                        ax.vlines(nd, lw, lw + sf * min_weight_increment, color='green', alpha=0.5, linewidth=vw)
                        ax.vlines(nd, lw + sf * min_weight_increment, lw + min_weight_increment, color='red', alpha=0.75, linewidth=vw)
                    if sf == 1:
                        ax.hlines(lw + sf * min_weight_increment, nd - 0.25, nd + 0.25, color='green', linewidth=3)

    # ----------------------------------------------------------------------------------------
    mfos = {
        'sessions': [],
        'last-weights': [],
        'last-but-one-weights': [],
        'last-send-fractions': [],
        'last-but-one-send-fractions': [],
    }
    xticks, xticklabels = [], []
    for hfo, xval, starts_block in iter_grip_sessions(gripname):
        if starts_block:
            for tk in mfos:
                mfos[tk].append([])
            xticks.append(xval)
            xticklabels.append(xtick_label(hfo))
        mfos['sessions'][-1].append(xval)

        gfo = hfo['grips'][gripname]
        body_weight = hfo.get('weight', 0) if args.add_body_weight else 0
        mfos['last-weights'][-1].append(body_weight + gfo['added-weights'][-1])
        mfos['last-but-one-weights'][-1].append(body_weight + gfo['added-weights'][-2])

        total_times = [n * float(hfo['cfg']['work_time']) for n in hfo['cfg']['n_reps']]
        if gfo['sent'] == 'yes':
            send_times = total_times
        elif gfo['sent'] == 'unknown' or 'fail-set' not in gfo:
            send_times = [0., 0.]  # TODO this should be unknown rather than 0
        else:
            if len(gfo['added-weights']) != hfo['cfg']['n_sets']:
                raise Exception('need to account for grip lines with different number of sets')
            assert gfo['fail-set'] > 0  # doesn't make sense
            send_times = [0., 0.]
            for set_number in range(1, gfo['fail-set'] + 1):  # use 1-indexing, since that's what i implicitly use in the text files
                n_reps = hfo['cfg']['n_reps'][set_number - 1]
                for rep_number in range(1, n_reps + 1):  # use 1-indexing, since that's what i implicitly use in the text files
                    if set_number == gfo['fail-set'] and rep_number == gfo['fail-rep']:
                        send_times[set_number - 1] += gfo['fail-second']
                        break
                    send_times[set_number - 1] += hfo['cfg']['work_time']
        mfos['last-but-one-send-fractions'][-1].append(send_times[0] / total_times[0])
        mfos['last-send-fractions'][-1].append(send_times[1] / total_times[1])

    fig, ax = start_figure(gripname)
    plot_set('last')
    plot_set('last-but-one')
    finish_figure(gripname, xticks, xticklabels, ax)

# ----------------------------------------------------------------------------------------
def plot_grip_ladder(gripname):
    """New format: one line per hand through the heaviest set, a bar down to the lightest
    set to show the whole ladder, and a hollow marker on any set I didn't finish. The two
    hands are nudged apart along x so their ladders don't sit on top of each other."""
    hnames = hangutils.hands(all_cfgs[0])
    dodges = {h: (ih - (len(hnames) - 1) / 2.) * 2 * hand_dodge for ih, h in enumerate(hnames)}
    mfos = {h: {'x': [], 'top': [], 'bottom': []} for h in hnames}  # each is a list (blocks) of lists (sessions)
    fails = {h: {'x': [], 'y': []} for h in hnames}
    xticks, xticklabels = [], []
    for hfo, xval, starts_block in iter_grip_sessions(gripname):
        if starts_block:
            for h in hnames:
                for tk in mfos[h]:
                    mfos[h][tk].append([])
            xticks.append(xval)
            xticklabels.append(xtick_label(hfo))
        gfo = hfo['grips'][gripname]
        body_weight = hfo.get('weight', 0) if args.add_body_weight else 0
        for hname in hnames:
            wgts = [body_weight + s[hname]['weight'] for s in gfo['sets'] if not math.isnan(s[hname]['weight'])]
            mfos[hname]['x'][-1].append(xval + dodges[hname])
            mfos[hname]['top'][-1].append(max(wgts) if len(wgts) > 0 else float('nan'))
            mfos[hname]['bottom'][-1].append(min(wgts) if len(wgts) > 0 else float('nan'))
            for sfo in gfo['sets']:
                if sfo[hname]['failed'] and not math.isnan(sfo[hname]['weight']):
                    fails[hname]['x'].append(xval + dodges[hname])
                    fails[hname]['y'].append(body_weight + sfo[hname]['weight'])

    fig, ax = start_figure(gripname)
    any_fails = False
    for hname in hnames:
        clr = hand_colors[hname]
        for iblock, (xlist, tlist, blist) in enumerate(zip(mfos[hname]['x'], mfos[hname]['top'], mfos[hname]['bottom'])):
            valid = [(x, t, b) for x, t, b in zip(xlist, tlist, blist) if not math.isnan(t)]
            if len(valid) == 0:
                continue
            vxs, vts, vbs = zip(*valid)
            ax.vlines(vxs, vbs, vts, color=clr, alpha=0.3, linewidth=7)  # the ladder, lightest to heaviest set
            ax.plot(vxs, vts, linewidth=2, alpha=0.9, markersize=10, marker='.', color=clr,
                    label=hname if iblock == 0 else None)
            if iblock == len(mfos[hname]['x']) - 1:  # direct label, so identity isn't only in the color
                ax.annotate(hname, (vxs[-1], vts[-1]), textcoords='offset points', xytext=(9, 0),
                            color=clr, fontsize=fsize, fontweight='bold', va='center', annotation_clip=False)
        if len(fails[hname]['x']) > 0:  # hollow marker: didn't finish this set (a shape, so it reads without color)
            any_fails = True
            ax.plot(fails[hname]['x'], fails[hname]['y'], linestyle='none', marker='o', markersize=12,
                    markerfacecolor='none', markeredgecolor=clr, markeredgewidth=2.5)
    handles, labels = ax.get_legend_handles_labels()
    if any_fails:
        handles.append(mpl.lines.Line2D([], [], linestyle='none', marker='o', markersize=12, markerfacecolor='none', markeredgecolor='dimgrey', markeredgewidth=2.5))
        labels.append('didn\'t finish')
    ax.legend(handles, labels, loc='upper left', framealpha=0.7)
    ax.set_ylabel('lb off the ground' if hangutils.is_lift(all_cfgs[0]) else 'added lb')
    ax.set_xlim(-1, max(x for h in hnames for xl in mfos[h]['x'] for x in xl) + 1.5)
    finish_figure(gripname, xticks, xticklabels, ax)

# ----------------------------------------------------------------------------------------
for gname in args.plot_grips:
    if new_format:
        plot_grip_ladder(gname)
    else:
        plot_grip_legacy(gname)
