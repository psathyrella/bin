#!/bin/bash
# Low-battery warnings while discharging, each shown once per drop:
#   at or below 10%: a dunst popup that stays until clicked
#   at or below 5%:  a full-width i3-nagbar across the top of the screen
# Run every 5 minutes by ~/.config/systemd/user/battery-alert.timer.

popup_threshold=10
bar_threshold=5
bat=/sys/class/power_supply/BAT1
flagdir=/run/user/$(id -u)

capacity=$(cat $bat/capacity)
status=$(cat $bat/status)

if [ "$status" != "Discharging" ]; then
    rm -f $flagdir/battery-alert-popup $flagdir/battery-alert-bar
    exit 0
fi
[ "$capacity" -gt "$popup_threshold" ] && rm -f $flagdir/battery-alert-popup
[ "$capacity" -gt "$bar_threshold" ] && rm -f $flagdir/battery-alert-bar

if [ "$capacity" -le "$popup_threshold" ] && [ ! -e $flagdir/battery-alert-popup ]; then
    notify-send -u critical "Battery low: ${capacity}%" "Plug in the charger."
    touch $flagdir/battery-alert-popup
fi

if [ "$capacity" -le "$bar_threshold" ] && [ ! -e $flagdir/battery-alert-bar ]; then
    # Started through i3 so the bar outlives this systemd service.
    i3-msg -q "exec --no-startup-id i3-nagbar -t error -m 'Battery critically low: ${capacity}%. Plug in the charger now.'"
    touch $flagdir/battery-alert-bar
fi
